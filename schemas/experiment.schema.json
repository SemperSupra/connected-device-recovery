{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/connected-device-recovery/schemas/experiment.schema.json",
  "title": "Connected Device Recovery Experiment",
  "type": "object",
  "required": ["id", "question", "stimulus", "observation_surfaces", "stop_when"],
  "properties": {
    "id": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "items": {"type": "string"}
    },
    "baseline_assertions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "stimulus": {},
    "held_constant": {
      "type": "array",
      "items": {"type": "string"}
    },
    "observation_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "stop_when": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "minItems": 1, "items": {"type": "string"}}
      ]
    },
    "safety": {
      "type": "array",
      "items": {"type": "string"}
    },
    "result": {"enum": ["PASS", "BLOCK", "FAILURE", "INCONCLUSIVE", "NOT_RUN"]},
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
