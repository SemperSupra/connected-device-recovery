{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/connected-device-recovery/schemas/trace.schema.json",
  "title": "Connected Device Recovery Normalized Trace Event",
  "type": "object",
  "required": ["ts", "source", "kind"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "source": {
      "enum": ["official-app", "oracle", "recovered", "device", "instrumentation"]
    },
    "kind": {
      "enum": [
        "advertisement",
        "gatt-service",
        "gatt-characteristic",
        "control-intent",
        "ble-read",
        "ble-write",
        "ble-notification",
        "observation",
        "error",
        "marker"
      ]
    },
    "specimen": {"type": ["string", "null"]},
    "experiment": {"type": ["string", "null"]},
    "device_identity": {"type": ["string", "null"]},
    "service": {"type": ["string", "null"]},
    "characteristic": {"type": ["string", "null"]},
    "value_hex": {
      "type": ["string", "null"],
      "pattern": "^[0-9A-Fa-f]*$"
    },
    "semantic": {},
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
