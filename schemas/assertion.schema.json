{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/connected-device-recovery/schemas/assertion.schema.json",
  "title": "Connected Device Recovery Assertion",
  "type": "object",
  "required": ["id", "state", "subject", "claim", "sources"],
  "properties": {
    "id": {"type": "string"},
    "state": {"enum": ["external", "observed", "qualified"]},
    "subject": {"type": "string"},
    "claim": {},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "locator"],
        "properties": {
          "kind": {"type": "string"},
          "locator": {"type": "string"},
          "revision": {"type": ["string", "null"]},
          "retrieved": {"type": ["string", "null"], "format": "date"}
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
